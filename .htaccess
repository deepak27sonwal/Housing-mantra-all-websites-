# =====================================================================
# Tanish Urbania - .htaccess for Apache / LiteSpeed shared hosting
# (cPanel, Hostinger, GoDaddy, Bluehost, etc.)
# Upload this file to the SAME folder as index.html (public_html).
# =====================================================================

# ---- Basics ---------------------------------------------------------
Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash On
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
AddDefaultCharset UTF-8

# ---- Redirects: HTTPS, one canonical host, clean URLs ----------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Force HTTPS (also works behind Cloudflare / hosting proxies)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://tanishurbania.com%{REQUEST_URI} [L,R=301]

  # 2) Send www to the non-www canonical host
  RewriteCond %{HTTP_HOST} ^www\.tanishurbania\.com$ [NC]
  RewriteRule ^ https://tanishurbania.com%{REQUEST_URI} [L,R=301]

  # 3) Hide index.html:  /blog/index.html  ->  /blog/     and  /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
  RewriteRule ^(.*?/)?index\.html$ /$1 [L,R=301,NC]

  # 4) Hide .html on any other page (404.html is kept as the error page)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
  RewriteRule ^(.+?)\.html$ /$1/ [L,R=301,NC]

  # 5) Collapse double slashes, e.g. //blog//  ->  /blog/
  RewriteCond %{THE_REQUEST} \s/{2,}
  RewriteRule ^(.*)$ /$1 [L,R=301]

  # 6) Add the trailing slash to page folders  (/blog/overview -> /blog/overview/)
  #    Files with an extension (css, js, images, xml, txt) are left alone.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# ---- Block files that should never be public --------------------------
<FilesMatch "(^\.|\.(py|md|json|log|sh|bak|sql)$|^README\.txt$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
# Never publish the build folder
<IfModule mod_rewrite.c>
  RewriteRule ^blog_data/ - [F,L]
</IfModule>

# ---- Correct file types ---------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
  AddType application/javascript .js
</IfModule>

# ---- Compression -----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# ---- Browser caching (images/css/js: long; HTML: short) ----------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # ---- Security headers ----------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
